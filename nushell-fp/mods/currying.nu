# ── uncurry ladder: invert a curried chain back to a flat closure ──
export def uncurry2 [fn: closure]: nothing -> closure { {|a, b| do (do $fn $a) $b} }
export def uncurry3 [fn: closure]: nothing -> closure { {|a, b, c| do (do (do $fn $a) $b) $c} }
export def uncurry4 [fn: closure]: nothing -> closure { {|a, b, c, d| do (do (do (do $fn $a) $b) $c) $d} }
